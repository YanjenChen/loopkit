#!/usr/bin/env python3
"""loopkit command-line entry point. Claude Code puts this directory on the Bash PATH."""

import os
import sys

if not sys.flags.isolated:
    # Isolated mode: ignore PYTHON* variables and user site-packages, so the
    # repository being optimized cannot shadow modules the framework imports.
    os.execv(sys.executable, [sys.executable, '-I', os.path.abspath(__file__)] + sys.argv[1:])

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from loopkit.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
